page {
  color: #293e34;
  background: #f7f6ef;
  font-family:
    -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei",
    sans-serif;
  font-size: 26rpx;
}
view,
button,
image,
text {
  box-sizing: border-box;
}
button {
  color: inherit;
  font: inherit;
  line-height: 1.4;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
}
button::after {
  border: 0;
}
button[disabled] {
  color: inherit;
  background: transparent;
  opacity: 0.5;
}
.page-shell {
  max-width: 1020rpx;
  padding: 0 30rpx;
  margin: 0 auto;
}
.site-header {
  display: flex;
  height: 108rpx;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #e3e6da;
}
.brand {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}
.brand-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  margin-right: 16rpx;
  padding-bottom: 3rpx;
  border-radius: 18rpx;
  background: #2f8064;
  color: #fffdf0;
  font-size: 49rpx;
  line-height: 1;
  box-shadow: 0 5rpx 0 #23664f;
  transform: rotate(-9deg);
}
.brand-dot {
  color: #2f8064;
}
.sound-button {
  flex-shrink: 0;
  padding: 15rpx 21rpx;
  border: 1rpx solid #dfe4d6;
  border-radius: 34rpx;
  background: #fffef7;
  font-size: 23rpx;
}
.intro {
  position: relative;
  padding: 32rpx 0 30rpx;
  text-align: center;
}
.eyebrow {
  display: inline-block;
  padding: 10rpx 20rpx;
  background: #eaf0e3;
  border-radius: 28rpx;
  color: #668672;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}
.intro-title {
  position: relative;
  margin-top: 23rpx;
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}
.title-highlight {
  color: #2f8064;
  border-bottom: 5rpx solid #e7b74c;
  padding-bottom: 3rpx;
}
.intro-description {
  display: block;
  margin-top: 22rpx;
  color: #818b77;
  font-size: 24rpx;
  letter-spacing: 1rpx;
}
.intro-star {
  position: absolute;
  right: 12rpx;
  top: 75rpx;
  color: #dfb251;
  font-size: 48rpx;
  transform: rotate(12deg);
}
.stage {
  position: relative;
  height: 460rpx;
  border: 2rpx solid #dce6d7;
  border-radius: 36rpx;
  overflow: hidden;
  background-color: #eaf0e5;
  background-image: radial-gradient(#b9ccba70 1rpx, transparent 1rpx);
  background-size: 32rpx 32rpx;
  box-shadow: inset 0 0 0 8rpx #f6f8ee80;
  --size: 166rpx;
  --half: 83rpx;
}
.stage-top {
  position: absolute;
  top: 30rpx;
  left: 29rpx;
  right: 29rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 3;
}
.stage-label {
  display: flex;
  align-items: center;
  color: #436b52;
  font-size: 22rpx;
  font-weight: 600;
}
.live-dot {
  width: 11rpx;
  height: 11rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #66946c;
  box-shadow: 0 0 0 6rpx #dce8d8;
}
.stage-badge {
  max-width: 260rpx;
  padding: 7rpx 14rpx;
  color: #809176;
  border: 1rpx solid #d7e2cf;
  background: #eff4e8;
  border-radius: 22rpx;
  font-size: 19rpx;
  white-space: nowrap;
}
.stage-orbit {
  position: absolute;
  width: 460rpx;
  height: 230rpx;
  border: 1rpx solid #bdceb74d;
  border-radius: 50%;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -35%) rotate(-17deg);
}
.orbit-two {
  width: 570rpx;
  height: 295rpx;
  transform: translate(-50%, -37%) rotate(18deg);
}
.stage-spark {
  position: absolute;
  color: #aec39b;
  font-size: 54rpx;
}
.spark-one {
  left: 46rpx;
  top: 120rpx;
  transform: rotate(-12deg);
}
.spark-two {
  right: 46rpx;
  bottom: 105rpx;
  font-size: 29rpx;
}
.dice-field {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  top: 106rpx;
  bottom: 78rpx;
  display: flex;
  align-items: center;
  align-content: center;
  justify-content: center;
  flex-wrap: wrap;
}
.die-slot {
  position: relative;
  display: flex;
  width: 100%;
  height: 224rpx;
  justify-content: center;
  align-items: center;
  padding-bottom: 24rpx;
}
.die-motion,
.die,
.dice-tilt,
.dice-cube {
  width: var(--size);
  height: var(--size);
}
.die {
  perspective: 1400rpx;
}
.dice-tilt {
  transform: rotateX(-58deg) rotateY(-28deg);
  transform-style: preserve-3d;
}
.dice-cube {
  position: relative;
  transform-style: preserve-3d;
  transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
}
.dice-face {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border: 2rpx solid #b3d4bd;
  border-radius: 18%;
  background: linear-gradient(140deg, #fbfff6, #cce2cc);
  box-shadow: inset 0 0 12rpx #ffffffcc;
  backface-visibility: hidden;
}
.dice-face.front {
  transform: translateZ(var(--half));
}
.dice-face.back {
  transform: rotateY(180deg) translateZ(var(--half));
}
.dice-face.right {
  transform: rotateY(90deg) translateZ(var(--half));
}
.dice-face.left {
  transform: rotateY(-90deg) translateZ(var(--half));
}
.dice-face.top {
  transform: rotateX(90deg) translateZ(var(--half));
}
.dice-face.bottom {
  transform: rotateX(-90deg) translateZ(var(--half));
}
.dice-face.is-result {
  background: linear-gradient(145deg, #ffffff, #e9f5df);
  border-color: #94bd96;
  box-shadow:
    inset 0 0 0 3rpx #fffdf4,
    inset 0 0 16rpx #ffffffcc;
}
.face-photo {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 17%;
  opacity: 0.8;
}
.pip {
  position: absolute;
  width: 17%;
  height: 17%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #2f785b;
  box-shadow:
    inset 1rpx 2rpx 3rpx #17462626,
    0 1rpx 0 #ffffffb3;
}
.pip-one {
  background: #c16b53;
  width: 21%;
  height: 21%;
}
.has-photo .pip {
  background: #213d32;
  box-shadow:
    0 0 0 3rpx #fffefa,
    0 2rpx 5rpx #18342766;
}
.has-photo .pip-one {
  background: #a54232;
}
.die-shadow {
  position: absolute;
  left: 50%;
  top: 72%;
  width: var(--size);
  height: 24rpx;
  transform: translateX(-50%) rotate(-8deg);
  border-radius: 50%;
  background: #496b4126;
  filter: blur(9rpx);
}
.die-value {
  position: absolute;
  top: 100%;
  left: 50%;
  margin-top: -4rpx;
  transform: translateX(-50%);
  color: #3e6950;
  background: #f8fbf0e6;
  padding: 5rpx 20rpx;
  border: 1rpx solid #d7e4cf;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}
.value-hidden {
  visibility: hidden;
}
.count-2 {
  --size: 134rpx;
  --half: 67rpx;
}
.count-2 .die-slot {
  width: 45%;
  height: 194rpx;
}
.count-3 {
  --size: 112rpx;
  --half: 56rpx;
}
.count-3 .die-slot {
  width: 32%;
  height: 180rpx;
}
.count-4,
.count-5,
.count-6 {
  height: 586rpx;
  --size: 106rpx;
  --half: 53rpx;
}
.count-4 .dice-field,
.count-5 .dice-field,
.count-6 .dice-field {
  top: 103rpx;
  bottom: 96rpx;
}
.count-4 .die-slot {
  width: 40%;
  height: 176rpx;
  margin-bottom: 18rpx;
}
.count-5 .die-slot,
.count-6 .die-slot {
  width: 32%;
  height: 176rpx;
  margin-bottom: 18rpx;
}
.count-4 .die-value,
.count-5 .die-value,
.count-6 .die-value {
  margin-top: -26rpx;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
}
.stage-caption {
  position: absolute;
  bottom: 26rpx;
  left: 22rpx;
  right: 22rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  color: #7d9275;
  font-size: 22rpx;
  letter-spacing: 1rpx;
}
.caption-spark {
  margin: 0 18rpx;
  color: #a7b899;
  font-size: 19rpx;
}
.roll-progress {
  position: absolute;
  bottom: 0;
  height: 7rpx;
  left: 0;
  right: 0;
  background: #dce7d4;
}
.progress-fill {
  height: 100%;
  background: #8bae78;
  transform-origin: left center;
  animation: progress 2s linear both;
}
.rolling .dice-cube {
  animation: tumble 0.72s linear infinite;
}
.rolling .die-motion {
  animation: hop 0.46s ease-in-out infinite alternate;
}
.rolling .die-slot:nth-child(2n) .dice-cube {
  animation-delay: -0.19s;
}
.rolling .die-slot:nth-child(2n) .die-motion {
  animation-delay: -0.23s;
}
.rolling .stage-spark {
  animation: sparkle 0.65s ease-in-out infinite alternate;
}
.rolling .live-dot {
  animation: blink 0.5s ease-in-out infinite alternate;
}
@keyframes tumble {
  from {
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  }
  to {
    transform: rotateX(calc(var(--rx, 0deg) + 360deg))
      rotateY(calc(var(--ry, 0deg) + 720deg));
  }
}
@keyframes hop {
  from {
    transform: translateY(0) rotate(-4deg);
  }
  to {
    transform: translateY(-30rpx) rotate(5deg);
  }
}
@keyframes sparkle {
  to {
    opacity: 0.35;
    transform: rotate(35deg) scale(0.75);
  }
}
@keyframes blink {
  to {
    opacity: 0.4;
  }
}
@keyframes progress {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}
