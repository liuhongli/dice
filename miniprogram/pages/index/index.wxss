.history-value {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 39rpx;
  height: 39rpx;
  margin: 4rpx 7rpx 4rpx 0;
  border: 1rpx solid #dce6cf;
  border-radius: 10rpx;
  background: #f1f6e9;
  color: #6f8e58;
  font-size: 23rpx;
  font-weight: 600;
}
.history-total {
  display: flex;
  align-items: center;
  color: #587c47;
  font-size: 31rpx;
  font-weight: 700;
}
.history-equals {
  margin-right: 10rpx;
  color: #a7ae97;
  font-size: 19rpx;
  font-weight: 400;
}
.page-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 52rpx;
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
  color: #a7ae98;
  font-size: 20rpx;
}
.page-footer text:first-child {
  color: #b9c4a6;
  font-size: 31rpx;
  margin-right: 12rpx;
}
.confetti-layer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  z-index: 20;
  overflow: hidden;
}
.confetti-piece {
  position: absolute;
  top: -20rpx;
  width: 13rpx;
  height: 22rpx;
  border-radius: 4rpx;
  animation: confetti-fall 1.8s ease-in both;
}
@keyframes confetti-fall {
  from {
    transform: translate3d(0, -4vh, 0) rotate(0);
    opacity: 1;
  }
  to {
    transform: translate3d(var(--drift, 40rpx), 103vh, 0) rotate(640deg);
    opacity: 0;
  }
}
.privacy-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 46rpx;
  background: #203b3077;
  z-index: 100;
}
.privacy-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 37rpx 32rpx 25rpx;
  background: #fffef6;
  border-radius: 31rpx;
  box-shadow: 0 15rpx 90rpx #19382d22;
  text-align: center;
}
.privacy-spark {
  display: block;
  font-size: 57rpx;
  color: #88a170;
}
.privacy-title {
  display: block;
  margin-top: 14rpx;
  font-size: 32rpx;
  font-weight: 700;
}
.privacy-copy {
  display: block;
  margin-top: 22rpx;
  text-align: left;
  color: #839072;
  font-size: 24rpx;
  line-height: 1.9;
}
.privacy-link {
  margin: 16rpx 0;
  padding: 13rpx 0;
  color: #2f8064;
  font-size: 24rpx;
  text-decoration: underline;
}
.privacy-agree {
  width: 100%;
  padding: 23rpx 14rpx;
  border-radius: 18rpx;
  background: #2f8064;
  color: #fffef5;
  font-size: 27rpx;
  font-weight: 600;
}
.privacy-decline {
  margin-top: 13rpx;
  padding: 17rpx;
  color: #949e83;
  font-size: 24rpx;
}
